# 排程間隔（分鐘），預設 10；錄製 demo 時可以設為 1
SCRAPE_INTERVAL_MINUTES=10

# 有設定就啟用 Telegram 通知
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 有設定就啟用 LINE 通知（Messaging API 的 push message）
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=

# Telegram 與 LINE 都沒有設定時，通知會輸出到終端機（docker compose logs monitor）

# 模擬商城自動變動價格與庫存的間隔（秒），設為 0 則只靠手動觸發
MOCK_CHANGE_INTERVAL_SECONDS=180
